@model IEnumerable<Hotel_Manager.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<h1>Rooms</h1>

<div class="row mb-4 align-items-end">
    <div class="col-md-5">
        <label class="form-label text-muted"> Search rooms</label>
        <input type="text" id="searchInput" class="form-control"
               placeholder="Room number or type..." onkeyup="filterRoomsTable()">
    </div>

    <div class="col-md-3">
        <label class="form-label text-muted">Availability</label>
        <select id="availableFilter" class="form-select" onchange="filterRoomsTable()">
            <option value="">All</option>
            <option value="True">Available</option>
            <option value="False">Occupied</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button onclick="resetRoomFilters()" class="btn btn-outline-secondary w-100">
            Reset Filters
        </button>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-success btn-lg">Create New</a>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table id="roomsTable" class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.RoomNumber)</th>
            <th>@Html.DisplayNameFor(model => model.IsAvailable)</th>
            <th>@Html.DisplayNameFor(model => model.RoomType)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.RoomNumber)</td>
                <td>@(item.IsAvailable ? "Yes" : "No")</td>
                <td>@Html.DisplayFor(modelItem => item.RoomType.Name)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function filterRoomsTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
            const availableFilter = document.getElementById('availableFilter').value;

            const rows = document.querySelectorAll('#roomsTable tbody tr');

            rows.forEach(row => {
                const roomNumber = row.cells[0].textContent.toLowerCase();
                const roomType   = row.cells[2].textContent.toLowerCase();
                const isAvailable = row.cells[1].textContent.trim() === "Yes" ? "True" : "False";

                const matchesSearch = !searchTerm ||
                    roomNumber.includes(searchTerm) ||
                    roomType.includes(searchTerm);

                const matchesAvailable = !availableFilter || isAvailable === availableFilter;

                row.style.display = (matchesSearch && matchesAvailable) ? '' : 'none';
            });
        }

        function resetRoomFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('availableFilter').value = '';
            filterRoomsTable();
        }
    </script>
}